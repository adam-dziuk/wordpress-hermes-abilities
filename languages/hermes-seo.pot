#. Plugin Name of the plugin
#: hermes-seo-abilities.php
msgid "Hermes SEO Abilities"
msgstr ""

#. Description of the plugin
#: hermes-seo-abilities.php
msgid "A minimal set of Abilities for an SEO agent. Drafts only — no publishing, deletion, media, or settings."
msgstr ""

#. Author of the plugin
#: hermes-seo-abilities.php
msgid "DD Systems - custom IT systems"
msgstr ""

#: hermes-seo-abilities.php:54
msgid "Hermes SEO Abilities requires WordPress 6.9 or later (the Abilities API has been part of core since that version). Please update WordPress for this plugin to work."
msgstr ""

#: hermes-seo-abilities.php:66
msgid "Hermes SEO"
msgstr ""

#: hermes-seo-abilities.php:67
msgid "Editorial operations for the SEO agent — drafts only."
msgstr ""

#: hermes-seo-abilities.php:109
msgid "Create draft post"
msgstr ""

#: hermes-seo-abilities.php:110
msgid "Creates a new post ALWAYS as a draft. Publishing is impossible through this ability."
msgstr ""

#: hermes-seo-abilities.php:188
msgid "Update draft"
msgstr ""

#: hermes-seo-abilities.php:189
msgid "Updates an existing draft. Refuses if the post is already published."
msgstr ""

#: hermes-seo-abilities.php:230
msgid "List categories"
msgstr ""

#: hermes-seo-abilities.php:231
msgid "Returns categories that exist on the site, with IDs and post counts."
msgstr ""

#: hermes-seo-abilities.php:263
msgid "List tags"
msgstr ""

#: hermes-seo-abilities.php:264
msgid "Returns tags that exist on the site, with IDs and post counts."
msgstr ""

#: hermes-seo-abilities.php:296
msgid "Search posts"
msgstr ""

#: hermes-seo-abilities.php:297
msgid "Searches published posts by keyword. Used for suggesting internal links."
msgstr ""

#: hermes-seo-abilities.php:343
msgid "List drafts"
msgstr ""

#: hermes-seo-abilities.php:344
msgid "Returns drafts (draft/pending) visible to the current account. Use it to check whether a post with a given slug or title already exists before creating a new one."
msgstr ""

#: hermes-seo-abilities.php:396
msgid "Get draft"
msgstr ""

#: hermes-seo-abilities.php:397
msgid "Returns the full data of a draft: title, slug, content, excerpt, Yoast fields, categories, and tags. Use it to verify that a save succeeded."
msgstr ""

#: hermes-seo-abilities.php:584
#: hermes-seo-abilities.php:822
msgid "No post exists with the given ID."
msgstr ""

#: hermes-seo-abilities.php:593
msgid "This post is not a draft. This ability does not modify published content."
msgstr ""

#: hermes-seo-abilities.php:603
msgid "You do not have permission to edit this post."
msgstr ""

#: hermes-seo-abilities.php:830
msgid "You do not have permission to read this post."
msgstr ""
